# Copy to .env and fill in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env && $EDITOR .env && set -a && . ./.env && set +a
#
# Nothing in this repo contains a credential. The Dynatrace token is read from
# an in-cluster Secret (default/gateway-dynatrace, key apiToken) at deploy time
# and is never written to a file. See docs/02-deploy-environment.md.

# --- required -------------------------------------------------------------

# Kubeconfig for the benchmark cluster. Every script refuses to run without it
# rather than silently using whatever context happens to be current — a
# benchmark that tears down the wrong cluster is an expensive kind of typo.
export KUBECONFIG=/path/to/benchmark-cluster.kubeconfig

# The name this cluster reports as `k8s.cluster.name` in Dynatrace. Every DQL
# query in benchmark/ is scoped by it, because workload names collide across
# clusters on one tenant: `bench-fluentbit-v5` on your other cluster would be
# silently averaged into your results.
export CLUSTER_NAME=logship-bench

# Dynatrace environment host, WITHOUT scheme and WITHOUT trailing slash.
# e.g. YOUR_ENV_ID.live.dynatrace.com   or   YOUR_ENV_ID.apps.dynatrace.com
export DT_ENDPOINT_HOST=YOUR_ENV_ID.live.dynatrace.com

# --- optional -------------------------------------------------------------

# Name of the in-cluster Secret holding the OTLP ingest token (key: apiToken).
export DT_SECRET=gateway-dynatrace

# Namespace the engine under test is deployed into.
export NS_ENGINE=default
