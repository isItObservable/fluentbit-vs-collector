#!/usr/bin/env bash
# ISI-3578 E4 — ARM 2 = Fluent Bit v5.1.1 — Tier 4 CONTROL (full stack, NO tail sampling).
# Launched by tier4-arm2-chain.sh after ARM 1 (collector+tail_sampling) completes a VALID soak,
# or manually by a heartbeat:  setsid bash tier4-arm2-driver.sh &
# Serial single-engine (pt9): tears down bench-collector FIRST, then applies fluentbit-tier4.yaml.
# Load = T3-shaped trace load (locust + k6 + telemetrygen traces@200/s --otlp-http :4318, 26h).
# T0 is committed ONLY after span ingest is confirmed on the FB traces pod (T3 lesson).
#   T+2h  -> 2h validity gate: census + DT-receipt(proc_records) + LOAD + leak -> POST.
#   T+26h -> 24h soak readout: same set -> POST, teardown both bench ns, flag tier4-comparison.
# This arm is the NO-TS control: the tail-sampling cost callout belongs to the collector arm.
set -uo pipefail
export KUBECONFIG="$HOME/.config/capmox/observable-otelarrow.kubeconfig"
KDIR="$HOME/.cache/fbvc-e0-branch"; KPI="$KDIR/kpi"; OUT="$KDIR/tiers/tier4"
HARNESS="/mnt/nas/projects/isitobservable/_artifacts/isi3572/E0/harness"
HARNESS2="$KDIR/harness"
FBMAN="$OUT/fluentbit-tier4.yaml"
ISSUE="997b27bb-1cd7-49c0-9353-a078c0be4031"   # ISI-3578
LOG="$OUT/arm2-driver.log"; exec >>"$LOG" 2>&1

post() { python3 - "$1" "$ISSUE" <<'PY'
import sys,json,urllib.request
req=urllib.request.Request("http://127.0.0.1:3100/api/issues/%s/comments"%sys.argv[2],
  data=json.dumps({"body":sys.argv[1]}).encode(),headers={"Content-Type":"application/json"},method="POST")
try: print("[post] HTTP",urllib.request.urlopen(req,timeout=30).status)
except Exception as e: print("[post] FAILED",e)
PY
}

echo "[arm2] START $(date -u +%FT%TZ) pid=$$ — tearing down collector arm (serial single-engine)"
kubectl delete ns bench-collector --wait=false 2>&1
for i in $(seq 1 60); do kubectl get ns bench-collector >/dev/null 2>&1 || break; sleep 10; done
kubectl get ns bench-collector >/dev/null 2>&1 && { echo "[arm2] bench-collector still terminating; proceeding"; }
kubectl apply -f "$FBMAN" 2>&1
echo "[arm2] waiting for FB pods Ready"; kubectl -n bench-fluentbit wait --for=condition=Ready pod --all --timeout=600s 2>&1

apply_load() {
  kubectl create ns bench-load 2>/dev/null; kubectl label ns bench-load oneagent=false --overwrite 2>&1
  kubectl -n bench-load delete deploy locust-oteldemo k6-hipstershop --ignore-not-found 2>&1
  kubectl -n bench-load delete job  tgen-traces tgen-metrics       --ignore-not-found 2>&1
  kubectl apply -f "$HARNESS/locust/locust-oteldemo.yaml" 2>&1
  kubectl apply -f "$HARNESS/k6/k6-hipstershop.yaml" 2>&1
  # FB `opentelemetry` input is HTTP-first (T3-resolved): --otlp-http via svc :4317 -> targetPort 4318.
  sed -e "s#PLACEHOLDER:4317#bench-fluentbit-otlp:4317#g" \
      -e 's#value: "2h"#value: "26h"#g' \
      -e 's#- --otlp-insecure#- --otlp-insecure\n            - --otlp-http#' \
      "$HARNESS2/telemetrygen-load.yaml" | kubectl apply -f - 2>&1
}
echo "[arm2] applying load (locust+k6+telemetrygen traces/metrics --otlp-http)"; apply_load

# Pre-T0 span-ingest confirmation (T3 FB-arm validation item): fluentbit_input_records_total>0.
ingest_ok=0
for i in $(seq 1 20); do
  pod=$(kubectl -n bench-fluentbit get pod -l app=bench-fluentbit-traces -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  [ -z "$pod" ] && { sleep 15; continue; }
  lp=$((19900 + RANDOM % 80)); kubectl -n bench-fluentbit port-forward "$pod" "$lp:2020" >/tmp/fbpf2.log 2>&1 & local_pf=$!
  sleep 4; M=$(curl -s --max-time 8 "http://127.0.0.1:$lp/api/v1/metrics/prometheus"); kill $local_pf 2>/dev/null || true
  n=$(awk '/^fluentbit_input_records_total/{s+=$2} END{print s+0}' <<<"$M")
  echo "[arm2] span-ingest check $i: pod=$pod input_records=${n:-0}"
  [ "${n:-0}" -gt 0 ] 2>/dev/null && { ingest_ok=1; break; }
  sleep 20
done
if [ "$ingest_ok" != 1 ]; then
  post "## Tier 4 · ARM 2 (FB v5.1.1 no-TS control) — LAUNCH ABORTED

Span ingest NOT confirmed on the FB traces pod (\`fluentbit_input_records_total\` stayed 0 after ~10 min). bench-load kept for triage. Investigate before relaunching \`tier4-arm2-driver.sh\`."
  echo "[arm2] ABORT — no span ingest"; exit 1
fi

fb_receipt() {
  local sent_total=0 fail_total=0 pod lp M s f
  while read -r pod; do
    [ -z "$pod" ] && continue
    lp=$((12900 + RANDOM % 400))
    kubectl -n bench-fluentbit port-forward "$pod" "$lp:2020" >/tmp/fb-pf4.log 2>&1 & local pf=$!
    sleep 4
    M=$(curl -s --max-time 8 "http://127.0.0.1:$lp/api/v1/metrics/prometheus"); kill $pf 2>/dev/null || true
    s=$(awk '/^fluentbit_output_proc_records_total/{s+=$2} END{print s+0}' <<<"$M")
    f=$(awk '/^fluentbit_output_dropped_records_total/{s+=$2} END{print s+0}' <<<"$M")
    echo "[dt-receipt] $pod proc=$s dropped=$f"
    sent_total=$(awk -v a="$sent_total" -v b="$s" 'BEGIN{print a+b}')
    fail_total=$(awk -v a="$fail_total" -v b="$f" 'BEGIN{print a+b}')
  done < <(kubectl -n bench-fluentbit get pods -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')
  echo "[dt-receipt] TOTAL proc_records=$sent_total dropped=$fail_total (logs+metrics+traces)"
  awk -v s="$sent_total" -v f="$fail_total" 'BEGIN{
    print (s>0 && f==0) ? "[dt-receipt] VERDICT: RECEIVED IN DYNATRACE (all signals processed, 0 dropped)" \
                        : "[dt-receipt] VERDICT: NOT CONFIRMED — investigate output" }'
}

load_check() {
  local lp kp tgen lreq
  lp=$(kubectl -n bench-load get pod -l app=locust-oteldemo -o jsonpath='{.items[0].status.phase}' 2>/dev/null)
  kp=$(kubectl -n bench-load get pod -l app=k6-hipstershop  -o jsonpath='{.items[0].status.phase}' 2>/dev/null)
  tgen=$(kubectl -n bench-load get pod -l app=tgen-traces   -o jsonpath='{.items[0].status.phase}' 2>/dev/null)
  lreq=$(kubectl -n bench-load logs -l app=locust-oteldemo --tail=60 2>/dev/null | awk '/Aggregated/{n=$2} END{print n+0}')
  echo "[load] locust(otel-demo) pod=$lp reqs=${lreq:-0} | k6(hipster-shop) pod=$kp | tgen-traces pod=$tgen (@200 span/s --otlp-http)"
  if [ "$lp" = "Running" ] && [ "$kp" = "Running" ] && [ "$tgen" = "Running" ] && [ "${lreq:-0}" -gt 0 ] 2>/dev/null; then
    echo "[load] LOAD REACHING APP: PASS (app load + telemetrygen traces into FB OTLP input)"
  else
    echo "[load] LOAD REACHING APP: FAIL — a generator is not Running (dataset INVALID)"
  fi
}

readout() { # $1 phase ; $2 outfile
  { echo "# Tier 4 CONTROL ARM (FB v5.1.1 full stack, NO tail sampling) — $1 readout"
    echo "generated: $(date -u +%FT%TZ) · engine=fluentbit-v5.1.1 (single, collector offline) · load=locust+k6+telemetrygen(traces@200 --otlp-http :4318)"
    echo "control framing: FB has NO tail sampling -> this arm = T3-shaped trace load; the T3->T4 tail-sampling cost is read on the COLLECTOR arm"
    echo; echo '## Census gate (validity FIRST — engine+infra STRICT, apps liveness-only)'
    STRICT_NS="bench-fluentbit kepler" bash "$KPI/census-gate.sh" bench-fluentbit kepler otel-demo hipster-shop 2>&1
    echo; echo '## Load reaching app gate (#6c)'; load_check
    echo; echo '## Dynatrace receipt gate (pt9 — FB output proc_records / dropped)'; fb_receipt
    echo; echo '## Leak readout — fluentbit (all components, tail-flat)'; bash "$KPI/leak-readout.sh" fluentbit 12 15 2>&1
    echo; echo '## Resource snapshot (working-set, per component)'; kubectl top pod -n bench-fluentbit --no-headers 2>&1
  } | tee "$2"
}

green() { grep -q "CENSUS GATE: PASS" "$1" && grep -q "RECEIVED IN DYNATRACE" "$1" && grep -q "LOAD REACHING APP: PASS" "$1"; }

T0=$(date -u +%FT%TZ); echo "[arm2] Tier4 ARM2(FB control)+LOAD T0=$T0"

sleep 7200
GATE="$OUT/tier4-fluentbit-2h-gate.md"; readout "2h validity gate" "$GATE"
if green "$GATE"; then GV="🟢 GREEN — census PASS + all signals processed to Dynatrace + load reaching app"; else GV="🔴 RED — a gate failed (dataset INVALID)"; fi
post "$(printf '## Tier 4 · ARM 2 (FB v5.1.1 no-TS CONTROL) — 2h validity gate: %s\n\nT0=%s · gate at %s · SINGLE-ENGINE (pt9), collector offline · signals=logs+metrics+traces (NO tail sampling — FB has none; control for the collector T3->T4 tail-sampling delta)\n\n```\n%s\n```\n\nArtifact: `tiers/tier4/tier4-fluentbit-2h-gate.md`. %s' \
  "$GV" "$T0" "$(date -u +%FT%TZ)" "$(sed -n '1,72p' "$GATE")" \
  "$(green "$GATE" && echo 'Soak continues; 24h readout auto-posts at T+26h.' || echo 'Halting before soak; investigate.')")"
green "$GATE" || { echo "[arm2] gate RED — halt (keeping bench-load for triage)"; exit 0; }

sleep 86400
FINAL="$OUT/tier4-fluentbit-results.md"; readout "24h soak" "$FINAL"
if grep -q "CENSUS GATE: PASS" "$FINAL"; then FV="🟢 VALID — 24h soak complete, census PASS"; else FV="🔴 INVALID — restart during soak"; fi
post "$(printf '## Tier 4 · ARM 2 (FB v5.1.1 no-TS CONTROL) — 24h soak COMPLETE: %s\n\nT0=%s · readout at %s\n\n```\n%s\n```\n\n**Next:** produce `tiers/tier4/tier4-comparison.md` (per-engine table: collector T4 vs collector T3 = tail-sampling CPU/mem/state cost; FB control = what no-TS looks like under the same load) -> E5 (ISI-3579).' \
  "$FV" "$T0" "$(date -u +%FT%TZ)" "$(sed -n '1,84p' "$FINAL")")"
echo "[arm2] tearing down bench-load + bench-fluentbit (E4 arms done)"
kubectl delete ns bench-load bench-fluentbit --wait=false 2>&1
echo "[arm2] Tier4 ARM2 DONE — remaining manual step: tier4-comparison.md -> E5"
